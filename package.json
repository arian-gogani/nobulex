{
  "name": "nobulex",
  "private": true,
  "version": "0.1.0",
  "description": "Open cryptographic protocol (MIT) — the trust layer for the agent economy. AI agents declare behavioral commitments, prove compliance, build verifiable reputation.",
  "workspaces": [
    "packages/types",
    "packages/crypto",
    "packages/core-types",
    "packages/ccl",
    "packages/core",
    "packages/covenant-lang",
    "packages/action-log",
    "packages/middleware",
    "packages/verification",
    "packages/composability",
    "packages/identity",
    "packages/enforcement",
    "packages/proof",
    "packages/alignment",
    "packages/antifragile",
    "packages/attestation",
    "packages/breach",
    "packages/canary",
    "packages/certification",
    "packages/compliance-autopilot",
    "packages/composition",
    "packages/consensus",
    "packages/derivatives",
    "packages/eu-compliance",
    "packages/gametheory",
    "packages/kova",
    "packages/legal",
    "packages/marketplace",
    "packages/mcp",
    "packages/negotiation",
    "packages/norms",
    "packages/rail",
    "packages/recursive",
    "packages/reputation",
    "packages/revenue",
    "packages/robustness",
    "packages/staking",
    "packages/substrate",
    "packages/temporal",
    "packages/trust-data",
    "packages/trust-futures",
    "packages/tee",
    "packages/contracts",
    "packages/elizaos-plugin",
    "packages/store",
    "packages/verifier",
    "packages/evm",
    "packages/sdk",
    "packages/react",
    "packages/mcp-server",
    "packages/cli"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "quickstart": "npx tsx examples/get-started-with-kova.ts",
    "lint": "eslint packages/*/src/**/*.ts",
    "docs": "npx typedoc",
    "docs:build": "typedoc",
    "prepublish:check": "npm pack --dry-run -ws",
    "publish:all": "npm run build && npm publish --workspaces",
    "prepare": "husky"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agbusiness195/NOBULEX"
  },
  "homepage": "https://nobulex.dev",
  "bugs": {
    "url": "https://github.com/agbusiness195/NOBULEX/issues"
  },
  "author": "Nobulex, Inc.",
  "license": "MIT",
  "lint-staged": {
    "packages/*/src/**/*.ts": [
      "eslint --fix"
    ]
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^8.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "solc": "^0.8.34",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
