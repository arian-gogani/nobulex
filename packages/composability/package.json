{
  "name": "@nobulex/composability",
  "version": "0.2.1",
  "description": "Covenant compatibility checking, agent matching, and trust topology analysis",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "https://github.com/arian-gogani/nobulex.git",
    "directory": "packages/composability"
  },
  "homepage": "https://nobulex.com",
  "bugs": { "url": "https://github.com/arian-gogani/nobulex/issues" },
  "author": "Nobulex Labs, Inc.",
  "keywords": ["nobulex", "covenant", "composability", "compatibility", "trust-topology"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm && tsc --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit",
    "bundle": "tsup src/index.ts --format cjs,esm",
    "dev": "tsup src/index.ts --format cjs,esm --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@nobulex/types": "0.2.1",
    "@nobulex/covenant-lang": "0.2.0"
  }
}
