{
  "name": "@nobulex/contracts",
  "version": "0.1.0",
  "description": "Solidity staking/slashing contracts — covenant registry, stake management, slashing on violation, TypeScript ABI bindings",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "compile:sol": "node scripts/compile.cjs",
    "build": "tsup src/index.ts --format cjs,esm && tsc --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nobulex/core-types": "0.1.0",
    "@nobulex/crypto": "0.1.0",
    "@nobulex/evm": "0.1.0"
  },
  "license": "MIT",
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "https://github.com/agbusiness195/nobulex.git",
    "directory": "packages/contracts"
  },
  "homepage": "https://stele.dev",
  "bugs": { "url": "https://github.com/agbusiness195/stele/issues" },
  "author": "Stele Labs, Inc.",
  "keywords": ["nobulex", "covenant", "ai-accountability", "solidity", "staking", "slashing", "smart-contracts"]
}
