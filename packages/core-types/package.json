{
  "name": "@nobulex/core-types",
  "version": "0.2.1",
  "description": "TypeScript interfaces for the six Nobulex covenant primitives: Identity, Covenant, Attestation, ActionLog, Verification, Enforcement",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "https://github.com/arian-gogani/nobulex.git",
    "directory": "packages/core-types"
  },
  "homepage": "https://nobulex.com",
  "bugs": { "url": "https://github.com/arian-gogani/nobulex/issues" },
  "author": "Nobulex Labs, Inc.",
  "keywords": ["nobulex", "covenant", "ai-accountability", "types", "did"],
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  }
}
