{
  "name": "@nobulex/core",
  "version": "1.0.3",
  "description": "Credit scores for AI agents. Every action builds a verifiable track record.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "postinstall.js",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arian-gogani/nobulex.git",
    "directory": "packages/core"
  },
  "keywords": [
    "nobulex",
    "trust-capital",
    "ai-agents",
    "credit-score",
    "agent-trust",
    "ai-security",
    "agent-governance",
    "reputation",
    "accountability",
    "ed25519"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "typecheck": "tsc --noEmit",
    "bundle": "tsup src/index.ts --format cjs,esm",
    "dev": "tsup src/index.ts --format cjs,esm --watch",
    "prepublishOnly": "npm run build",
    "postinstall": "node postinstall.js || true"
  },
  "dependencies": {
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^1.8.0"
  }
}
