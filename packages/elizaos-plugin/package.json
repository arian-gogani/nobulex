{
  "name": "@nobulex/elizaos-plugin",
  "version": "0.2.1",
  "description": "ElizaOS plugin — actions, evaluators, providers, and plugin registration for covenant-governed AI agents",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm && tsc --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nobulex/core-types": "0.2.0",
    "@nobulex/crypto": "0.2.0",
    "@nobulex/identity": "0.2.0",
    "@nobulex/covenant-lang": "0.2.0",
    "@nobulex/action-log": "0.2.0",
    "@nobulex/middleware": "0.2.0",
    "@nobulex/verification": "0.2.0"
  },
  "license": "MIT",
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "https://github.com/arian-gogani/nobulex.git",
    "directory": "packages/elizaos-plugin"
  },
  "homepage": "https://nobulex.com",
  "bugs": { "url": "https://github.com/arian-gogani/nobulex/issues" },
  "author": "Nobulex Labs, Inc.",
  "keywords": ["nobulex", "covenant", "ai-accountability", "elizaos", "plugin", "ai-agent"]
}
