{
  "name": "@nobulex/merkle",
  "version": "0.2.1",
  "description": "Merkle tree with domain separation and epoch-based batching for evidence items",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "module": "dist/index.mjs",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "default": "./dist/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "files": ["dist", "README.md", "LICENSE"],
  "dependencies": {
    "@nobulex/crypto": "0.2.0"
  },
  "license": "MIT",
  "engines": { "node": ">=18" },
  "publishConfig": { "access": "public" },
  "repository": {
    "type": "git",
    "url": "https://github.com/arian-gogani/nobulex.git",
    "directory": "packages/merkle"
  },
  "keywords": ["nobulex", "merkle", "proof", "hash-tree"]
}
