{
  "name": "@nobulex/quickstart",
  "version": "0.2.1",
  "description": "Quick start for Nobulex proof-of-behavior protocol",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arian-gogani/nobulex.git",
    "directory": "packages/quickstart"
  },
  "keywords": [
    "nobulex",
    "quickstart",
    "covenant",
    "middleware",
    "identity",
    "ai-safety"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm && tsc --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit",
    "bundle": "tsup src/index.ts --format cjs,esm",
    "dev": "tsup src/index.ts --format cjs,esm --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@nobulex/covenant-lang": "0.2.0",
    "@nobulex/middleware": "0.2.0",
    "@nobulex/identity": "0.2.0",
    "@nobulex/crypto": "0.2.0",
    "@nobulex/core-types": "0.2.0"
  }
}
