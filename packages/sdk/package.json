{
  "name": "@nobulex/sdk",
  "version": "0.2.2",
  "description": "Nobulex SDK — the proof-of-behavior protocol for autonomous AI agents",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@nobulex/action-log": "0.2.0",
    "@nobulex/ccl": "0.2.0",
    "@nobulex/composability": "0.2.0",
    "@nobulex/core": "0.2.0",
    "@nobulex/covenant-lang": "0.2.0",
    "@nobulex/crypto": "0.2.0",
    "@nobulex/identity": "0.2.0",
    "@nobulex/middleware": "0.2.0",
    "@nobulex/store": "0.2.0",
    "@nobulex/types": "0.2.0",
    "@nobulex/verification": "0.2.0",
    "@nobulex/verifier": "0.2.0"
  },
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/arian-gogani/nobulex.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://nobulex.com",
  "bugs": {
    "url": "https://github.com/arian-gogani/nobulex/issues"
  },
  "author": "Nobulex Labs, Inc.",
  "keywords": [
    "nobulex",
    "covenant",
    "ai-accountability",
    "sdk"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "devDependencies": {
    "fast-check": "^4.6.0"
  }
}
