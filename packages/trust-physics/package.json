{
  "name": "@nobulex/trust-physics",
  "version": "0.2.0",
  "description": "Multidimensional, directional, time-decaying, context-dependent, composable trust framework for the Nobulex covenant protocol",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/agbusiness195/Nobulex.git",
    "directory": "packages/trust-physics"
  },
  "keywords": [
    "nobulex",
    "covenant",
    "ai-accountability",
    "trust",
    "trust-physics",
    "reputation",
    "trust-vector",
    "trust-graph"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm && tsc --emitDeclarationOnly --outDir dist",
    "typecheck": "tsc --noEmit",
    "bundle": "tsup src/index.ts --format cjs,esm",
    "dev": "tsup src/index.ts --format cjs,esm --watch",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@nobulex/crypto": "0.2.0",
    "@nobulex/core": "0.2.0",
    "@nobulex/identity": "0.2.0",
    "@nobulex/proof": "0.2.0"
  }
}
