{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@nobulex/*": ["packages/*/src"]
    }
  },
  "include": [
    "packages/types/src/index.ts",
    "packages/crypto/src/index.ts",
    "packages/identity/src/index.ts",
    "packages/covenant-lang/src/index.ts",
    "packages/action-log/src/index.ts",
    "packages/middleware/src/index.ts",
    "packages/verification/src/index.ts",
    "packages/sdk/src/index.ts",
    "packages/merkle/src/index.ts",
    "packages/tee/src/index.ts"
  ],
  "exclude": ["**/*.test.ts", "tests/**"]
}
